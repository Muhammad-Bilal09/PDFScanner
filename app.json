{
  "expo": {
    "name": "PDFScanner",
    "slug": "PDFScanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pdfscanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.medialinks.PDFScanner"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermissionText": "DocScan Pro needs camera access to scan documents."
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "DocScan Pro requires camera access to scan documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DocScan Pro requires photo library access to import document images."
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5047cc12-3e9b-4bad-b5f0-4c44f1206c10"
      }
    }
  }
}
